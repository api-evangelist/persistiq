{
  "opencollection": "1.0.0",
  "info": {
    "name": "PersistIQ Campaigns Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.persistiq.com/v1/users"
          },
          "docs": "Retrieves all non-archived users in your company."
        }
      ]
    }
  ],
  "bundled": true
}